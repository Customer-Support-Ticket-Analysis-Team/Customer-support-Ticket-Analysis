import pandas as pd


df = pd.read_csv("customer_support_tickets.csv")
df.head()


df.shape


df.columns


df.info()


df.describe()


df.describe(include="object")


missing = pd.DataFrame({
    "Missing Count": df.isnull().sum(),
    "Missing Percentage": (
        df.isnull().mean() * 100
    ).round(2)
})

missing.sort_values(
    by="Missing Percentage",
    ascending=False
)


import matplotlib.pyplot as plt
import seaborn as sns
plt.figure(figsize=(12, 5))

sns.heatmap(
    df.isnull(),
    cbar=False,
    yticklabels=False
)

plt.title("Missing Values Analysis")
plt.show()


df.duplicated().sum()


df["Ticket ID"].duplicated().sum()


df[df["Ticket ID"].duplicated(keep=False)].sort_values("Ticket ID")


df.dtypes


df1 = df.copy()

df1["Ticket ID"] = (
    pd.to_numeric(df1["Ticket ID"])
    .map(lambda x: f"T-{x:03.0f}")
    .astype("string")
)


df1["Date of Purchase"] = pd.to_datetime(
    df1["Date of Purchase"],
    format="%d-%m-%Y",
    errors="coerce"
)


df1["Date of Purchase"].dtype


date_columns = [
    "First Response Time",
    "Time to Resolution"
]

for col in date_columns:
    df1[col] = pd.to_datetime(
        df1[col],
        format="%d-%m-%Y %H:%M",
        errors="coerce"
    )


df1[date_columns].dtypes


status_check = (
    df1.groupby("Ticket Status")
    ["Time to Resolution"]
    .agg(
        Total="count",
    )
)


status_check = (
    df1.assign(
        resolution_missing=df1["Time to Resolution"].isna()
    )
    .groupby("Ticket Status")
    .agg(
        Total_Tickets=("Ticket ID", "count"),
        Missing_Resolution=("resolution_missing", "sum")
    )
)

status_check["Missing_Percentage"] = (
    status_check["Missing_Resolution"]
    / status_check["Total_Tickets"] * 100
).round(2)

status_check


df1.dtypes


categorical_columns = [
    "Customer Gender",
    "Product Purchased",
    "Ticket Type",
    "Ticket Status",
    "Ticket Priority",
    "Ticket Channel"
]

for col in categorical_columns:
    print(f"\n{col}")
    print(df[col].value_counts(dropna=False))


df1["Ticket Status"] = df1["Ticket Status"].replace({
    "Pending Customer Response": "Pending"
})


numerical_columns = [
    "Customer Age",
    "Customer Satisfaction Rating"
]

for col in numerical_columns:
    print(f"\n{col}")
    print(df1[col].describe())


plt.figure(figsize=(12, 5))

sns.boxplot(data=df1[numerical_columns])

plt.title("Numerical Features - Outlier Detection")
plt.xticks(rotation=20)
plt.show()


print("Earliest Purchase Date:",
      df1["Date of Purchase"].min())

print("Latest Purchase Date:",
      df["Date of Purchase"].max())


df1["Date of Purchase"].dt.year.value_counts().sort_index().plot(
    kind="bar",
    figsize=(10, 4)
)

plt.title("Purchase Distribution by Year")
plt.xlabel("Year")
plt.ylabel("Records")
plt.show()


text_columns = [
    "Ticket Subject",
    "Ticket Description",
    "Resolution"
]

for col in text_columns:
    empty_count = (
        df1[col].fillna("").str.strip().eq("").sum()
    )

    print(col, empty_count)


df1["Description Length"] = (
    df1["Ticket Description"]
    .fillna("")
    .str.len()
)

df1["Description Length"].describe()


df1.head()


selected_columns = [
    "Ticket ID",
    "Product Purchased",
    "Ticket Type",
    "Ticket Status",
    "Ticket Priority",
    "Ticket Channel",
    "First Response Time",
    "Time to Resolution",
    "Customer Satisfaction Rating"
]

analysis_df = df1[selected_columns].copy()

analysis_df.head()


import matplotlib.pyplot as plt
import seaborn as sns
import pandas as pd

# Cleaned dataset ki copy
eda_df = analysis_df.copy()

plt.figure(figsize=(10, 5))

order = eda_df["Ticket Type"].value_counts().index

sns.countplot(
    data=eda_df,
    y="Ticket Type",
    order=order
)

plt.title("Ticket Type Distribution")
plt.xlabel("Number of Tickets")
plt.ylabel("Ticket Type")

plt.tight_layout()
plt.show()


type_summary = (
    eda_df["Ticket Type"]
    .value_counts()
    .to_frame("Ticket Count")
)

type_summary["Percentage"] = (
    type_summary["Ticket Count"]
    / len(eda_df) * 100
).round(2)

type_summary


plt.figure(figsize=(9, 5))

order = eda_df["Ticket Priority"].value_counts().index

sns.countplot(
    data=eda_df,
    y="Ticket Priority",
    order=order
)

plt.title("Ticket Priority Distribution")
plt.xlabel("Number of Tickets")
plt.ylabel("Priority")

plt.tight_layout()
plt.show()


plt.figure(figsize=(8, 5))

sns.countplot(
    data=eda_df,
    x="Ticket Status",
    order=eda_df["Ticket Status"].value_counts().index
)

plt.title("Ticket Status Distribution")
plt.xlabel("Ticket Status")
plt.ylabel("Number of Tickets")

plt.tight_layout()
plt.show()


plt.figure(figsize=(9, 5))

order = eda_df["Ticket Channel"].value_counts().index

sns.countplot(
    data=eda_df,
    y="Ticket Channel",
    order=order
)

plt.title("Ticket Channel Distribution")
plt.xlabel("Number of Tickets")
plt.ylabel("Support Channel")

plt.tight_layout()
plt.show()


product_counts = (
    eda_df["Product Purchased"]
    .value_counts()
    .head(10)
)

plt.figure(figsize=(10, 5))

sns.barplot(
    x=product_counts.values,
